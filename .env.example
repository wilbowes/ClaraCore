# ClaraCore - Environment Variables
# Copy this to .env and fill in your values

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
ALLOWED_USER_IDS=your_telegram_user_id  # comma-separated if multiple users

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Home Assistant
HA_URL=http://your_ha_instance:8123
HA_TOKEN=your_ha_long_lived_token

# Music Assistant
MA_URL=http://your_ma_instance:8095
MA_TOKEN=your_ma_token

# CalDAV (Apple Calendar)
CALDAV_USERNAME=your_email
CALDAV_PASSWORD=your_password

# Brave Search
BRAVE_API_KEY=your_brave_api_key

# PTV (Melbourne public transport — remove if not in Melbourne)
PTV_DEV_ID=your_ptv_dev_id
PTV_API_KEY=your_ptv_api_key

# Last.fm
LASTFM_API_KEY=your_lastfm_api_key

# llama.cpp (used by health checks)
LLAMA_URL=http://your_ollama_instance:11434

# Voice server
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
VOICE_USER=your_username
VOICE_CHAT_ID=your_telegram_chat_id
WS_PORT=8765
